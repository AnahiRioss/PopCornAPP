<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">
 <ImageView 
         android:layout_width="0dp" 
         android:layout_height="0dp"
         android:src="@drawable/fondo"
         android:scaleType="centerCrop"
         app:layout_constraintEnd_toEndOf="parent"
         app:layout_constraintBottom_toBottomOf="parent"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintTop_toTopOf="parent"
 />
    <androidx.cardview.widget.CardView
            android:id="@+id/contenedor"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           app:layout_constraintEnd_toEndOf="parent"
           app:layout_constraintBottom_toBottomOf="parent"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintTop_toTopOf="parent"
           android:layout_margin="35dp"
           app:cardElevation="35dp"
           app:cardCornerRadius="40dp"
           android:backgroundTint="#FFFFFF"

    >
      <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center"
              android:orientation="vertical"
              android:padding="20dp"
      >


          <TextView
                  android:id="@+id/tvTitulo"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="PopCorn"
                  android:textSize="35sp"
                  android:textColor="#A51F24"
                  android:layout_marginTop="30dp"
                  android:textStyle="bold"

          />

          <EditText
                  android:id="@+id/etCorreo"
                  android:layout_width="match_parent"
                  android:layout_height="50dp"
                  android:layout_marginTop="30dp"
                  android:hint="Ingrese correo Electrónico"
                  android:inputType="textEmailAddress"
                  android:background="@drawable/bg_input"
                  android:paddingStart="15dp"
                  android:paddingEnd="15dp"
                  android:textColor="@color/black"
                  android:drawablePadding="10dp"
                  android:drawableStart="@drawable/email2"
                  android:textSize="16sp"

                  />

          <EditText
                  android:id="@+id/etPassword"
                  android:layout_width="match_parent"
                  android:layout_height="50dp"
                  android:layout_marginTop="15dp"
                  android:hint="Ingresa tu contraseña"
                  android:inputType="textPassword"
                  android:background="@drawable/bg_input"
                  android:paddingStart="15dp"
                  android:paddingEnd="15dp"
                  android:textColor="@color/black"
                  android:drawablePadding="10dp"
                  android:drawableStart="@drawable/pass"
                  android:textSize="16sp"/>

          <androidx.appcompat.widget.AppCompatButton
                  android:id="@+id/btnIngresar"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="56dp"
                  android:background="@drawable/button"
                  android:text="Inicia Sesión"
                  android:textAllCaps="false"
                  android:textColor="#FFF8F0"
                  android:textStyle="bold"
                  android:textSize="16sp"

                  />

          <TextView
                  android:id="@+id/tvCrearCuenta"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="50dp"
                  android:text="¿No tienes Cuenta?, Registrate aquí"
                  android:textColor="#8B2523"
                  android:textSize="13sp"
                  android:textStyle="bold"
                  android:layout_marginBottom="15dp"
          />



      </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>